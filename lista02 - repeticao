# Questao 3
#include <stdio.h>
int main(){
    int contador, numero, maior;
    scanf("%d %d", &contador, &numero);
    maior = numero;
    
    for (int i = 0; i < contador; i ++){
        scanf("%d", &numero);
        if (numero > maior){
            maior = numero;
        }
    }
    printf("%d", maior);
}

# Questao 4
#include <stdio.h>
int main(){
    int numero, contador = 0, contador_par = 0, contador_impar = 0;
    while (contador < 20){
        scanf("%d", &numero);
        if (numero % 2 == 0){
            contador_par ++;
        }
        else{
            contador_impar ++;
        }
        contador++;
    
    }
    printf("PAR: %d \nIMPAR: %d",contador_par,contador_impar);
}

