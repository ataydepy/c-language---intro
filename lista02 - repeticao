# Questão 11
#include <stdio.h>
int main(){
    int numero, contador = 1;
    double conta = 0;
    scanf("%d", &numero);
    while(contador <= numero){
        conta = conta + (1.0/contador);
        contador ++;
    }
    printf("%.2lf", conta);
}

