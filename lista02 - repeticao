# Questão 8 
#include <stdio.h>

int main(){
    int contador = 0;
    float salario, prestacao;
    while (1){
        scanf("%f %f", &salario, &prestacao);
        if (salario < 0){
            break;
        }
        if (prestacao > 0.3 * salario){
            printf("EMPRESTIMO NEGADO\n");
        }
        else {
            printf("EMPRESTIMO CONCEDIDO\n");
        }
        contador++;
    }
}

