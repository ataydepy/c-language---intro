# Questao 1
#include <stdio.h>
#include <math.h>
int main(){
    int contador = 0;
    while (contador < 20){
        int numero, cubo;
        scanf("%d", &numero);
        cubo = (numero * numero * numero);
        printf("%d\n", cubo);
        contador = contador +1;
    }
}

# Questao 2
#include <stdio.h>
int main(){
    int n, conta;
    int contador = 0; 
    scanf("%d", &n);
    for (int i = 0; i < n; i ++){
        conta = conta + i;
        contador++;
    }
    printf("%d", conta);
}

# Questao 3
#include <stdio.h>
int main(){
    int contador, numero, maior;
    scanf("%d %d", &contador, &numero);
    maior = numero;
    
    for (int i = 0; i < contador; i ++){
        scanf("%d", &numero);
        if (numero > maior){
            maior = numero;
        }
    }
    printf("%d", maior);
}

# Questao 4
#include <stdio.h>
int main(){
    int numero, contador = 0, contador_par = 0, contador_impar = 0;
    while (contador < 20){
        scanf("%d", &numero);
        if (numero % 2 == 0){
            contador_par ++;
        }
        else{
            contador_impar ++;
        }
        contador++;
    
    }
    printf("PAR: %d \nIMPAR: %d",contador_par,contador_impar);
}

# Questao 5
#include <stdio.h>
int main(){
    int numeros, contador,soma;
    scanf("%d", &contador);
    for(int i = 0; i < contador; i++){
        scanf("%d", &numeros);
        if(numeros % 2 == 0){
            soma = soma + numeros;
        }
    }
    printf("%d", soma);
}

