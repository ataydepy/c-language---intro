#include <stdio.h>
int main(){
    float l,m,n;
    scanf("%f %f %f", &l, &m, &n);
    if (l > m && l > n){
        if (m > n){
            printf("%.0f %.0f %.0f", n, m, l);
        }
        else{
            printf("%.0f %.0f %.0f", m, n, l);
        }
    }
    else if (m > n && m > l){
        if (n > l){
            printf("%.0f %.0f %.0f", l, n, m);
        }
        else{
            printf("%.0f %.0f %.0f", n, l, m);
        }
    }
    else{
        if (m > l){
            printf("%.0f %.0f %.0f", l, m, n);
        }
        else{
            printf("%.0f %.0f %.0f", m, l, n);
        }
        
    }
}
