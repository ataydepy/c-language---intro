// Questao 3
#include <stdio.h>
int main(){
    printf("---JOGO DE ADIVINHACAO---\nDigite um numero: ");
    int numero_fixo = 42, numero_coletado;
    scanf("%d", &numero_coletado);
    while(numero_coletado != numero_fixo){
        if(numero_coletado < numero_fixo){
            printf("Numero menor que o numero sorteado\nTente novamente: ");
        }else if(numero_coletado > numero_fixo){
            printf("Numero maior que o numero sorteado\nTente novamente: ");
        }
        scanf("%d", &numero_coletado);
    }
    printf("Voce acertou o numero");
    return 0;
}



// Questao 4
#include <stdio.h>
int main(){
    printf("Digite quaisquer numeros para uma soma. \nPara parar o programa digite um numero negativo\n");
    int numeros, soma = 0;
    scanf("%d", &numeros);
    while(numeros > 0){
        soma = soma + numeros;
        printf("Adicione mais um numero");
        scanf("%d", &numeros);
    }
    printf("A soma dara: %d\n", soma);
}

// Questao 5
#include <stdio.h>
int main(){
    int numero, expoente, resultado = 1, contador = 0;
    scanf("%d %d", &numero, &expoente);
    while(contador < expoente){
        resultado = resultado * numero;
        contador ++;
    }
    printf("%d\n", resultado);
}


